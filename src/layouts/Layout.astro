---
import '../styles/global.css';

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Hum Jeetenge — Summer 120 Challenge Habit Tracker. Track 10 daily habits, score 100 points, build unstoppable discipline." />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <title>{title} | Hum Jeetenge 🏆</title>
</head>
<body>
  
  <div class="flex min-h-screen bg-[#050505] relative overflow-hidden" id="app-root">
    
    <!-- Ambient Particles Canvas -->
    <canvas id="particles-canvas" class="absolute inset-0 pointer-events-none z-0 opacity-40"></canvas>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar hidden lg:flex flex-col p-4 z-40 relative bg-[#050505]">
      
      <!-- Brand -->
      <a href="/" class="flex items-center gap-3 mb-8 px-3 mt-2 group">
        <div class="w-10 h-10 bg-gradient-to-br from-[#f5c518] to-[#ff6b35] rounded-xl flex items-center justify-center shadow-[0_0_20px_rgba(245,197,24,0.3)] group-hover:shadow-[0_0_30px_rgba(245,197,24,0.5)] transition-all duration-300">
          <span class="text-lg">🏆</span>
        </div>
        <div>
          <h1 class="text-lg font-extrabold tracking-tight text-white leading-none">Hum Jeetenge</h1>
          <span class="text-[10px] font-bold text-[#f5c518]/60 uppercase tracking-widest">Summer 120</span>
        </div>
      </a>

      <!-- Nav Links -->
      <nav class="flex flex-col gap-0.5 flex-1">
        <div class="text-[10px] font-bold text-[#333] uppercase tracking-widest px-4 mb-2 mt-4">Tracker</div>
        
        <a href="/" id="nav-dashboard" class={`nav-item ${activePage === 'dashboard' ? 'active' : ''}`}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Dashboard
        </a>
        <a href="/calendar" id="nav-calendar" class={`nav-item ${activePage === 'calendar' ? 'active' : ''}`}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Calendar
        </a>
        <a href="/analytics" id="nav-analytics" class={`nav-item ${activePage === 'analytics' ? 'active' : ''}`}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          Analytics
        </a>
        <a href="/journal" id="nav-journal" class={`nav-item ${activePage === 'journal' ? 'active' : ''}`}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Journal
        </a>

        <div class="text-[10px] font-bold text-[#333] uppercase tracking-widest px-4 mt-8 mb-2">Data</div>
        
        <button id="btn-export" class="nav-item text-left w-full">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export Backup
        </button>
        <label class="nav-item cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Import Backup
          <input type="file" id="btn-import" accept=".json" class="hidden" />
        </label>

        <div class="text-[10px] font-bold text-[#333] uppercase tracking-widest px-4 mt-8 mb-2">Cloud Sync</div>
        <button id="btn-login" class="nav-item text-left w-full flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
          Login with Google
        </button>
        <button id="btn-logout" class="nav-item text-left w-full hidden flex items-center gap-2 text-rose-400 hover:text-rose-300">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Logout
        </button>

        <!-- Saved Indicator -->
        <div class="mt-auto px-4 py-3">
          <div id="save-indicator" class="flex items-center gap-2 text-[10px] text-[#444]">
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
            <span>Data saved locally</span>
          </div>
        </div>
      </nav>
    </aside>

    <!-- Mobile Header -->
    <div class="lg:hidden fixed top-0 left-0 right-0 h-14 glass border-b border-[#1e1e1e] z-50 flex items-center justify-between px-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-gradient-to-br from-[#f5c518] to-[#ff6b35] rounded-lg flex items-center justify-center">
          <span class="text-sm">🏆</span>
        </div>
        <h1 class="text-base font-extrabold tracking-tight text-white">Hum Jeetenge</h1>
      </div>
      <button id="mobile-menu-btn" class="w-8 h-8 flex items-center justify-center text-white">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <!-- Mobile Bottom Nav -->
    <nav class="lg:hidden fixed bottom-0 left-0 right-0 h-16 glass border-t border-[#1e1e1e] z-50 flex items-center justify-around px-2">
      <a href="/" class={`flex flex-col items-center gap-0.5 text-[10px] font-semibold px-3 py-1 rounded-lg transition-colors ${activePage === 'dashboard' ? 'text-[#f5c518]' : 'text-[#666]'}`}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        Home
      </a>
      <a href="/calendar" class={`flex flex-col items-center gap-0.5 text-[10px] font-semibold px-3 py-1 rounded-lg transition-colors ${activePage === 'calendar' ? 'text-[#f5c518]' : 'text-[#666]'}`}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Calendar
      </a>
      <a href="/analytics" class={`flex flex-col items-center gap-0.5 text-[10px] font-semibold px-3 py-1 rounded-lg transition-colors ${activePage === 'analytics' ? 'text-[#f5c518]' : 'text-[#666]'}`}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Stats
      </a>
      <a href="/journal" class={`flex flex-col items-center gap-0.5 text-[10px] font-semibold px-3 py-1 rounded-lg transition-colors ${activePage === 'journal' ? 'text-[#f5c518]' : 'text-[#666]'}`}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Journal
      </a>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-1 w-full flex flex-col min-h-screen relative z-10">
      
      <!-- Top Bar -->
      <header class="h-14 border-b border-[#1e1e1e] hidden lg:flex items-center justify-between px-8 sticky top-0 glass z-30">
        <div class="text-sm text-[#666]">
          <span id="header-date" class="font-medium"></span>
        </div>
        <div class="flex items-center gap-6 text-sm font-medium font-mono-num">
          <div class="flex items-center gap-2 text-[#f5c518]" title="Current Streak">
            <span>🔥</span>
            <span id="header-streak">0</span>
          </div>
          <div class="flex items-center gap-2 text-emerald-400" title="Total XP">
            <span>⚡</span>
            <span id="header-xp">0</span>
          </div>
          <div id="header-level" class="flex items-center gap-2 px-3 py-1 rounded-full bg-[#111] border border-[#222] text-xs font-bold" title="Level">
            <span>Lv.1</span>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <div class="p-4 md:p-8 lg:p-10 max-w-6xl mx-auto w-full flex-1 pt-18 lg:pt-4 pb-24 lg:pb-4">
        <slot />
      </div>
    </main>
  </div>

  <!-- Toast Notification System -->
  <div id="toast-container" class="fixed bottom-20 lg:bottom-6 right-6 flex flex-col gap-3 z-[9999]"></div>

  <!-- Confetti Container -->
  <div id="confetti-container" class="confetti-container hidden"></div>

  <script>
    import { auth, db, googleProvider, signInWithPopup, signOut, doc, setDoc, getDoc } from '../lib/firebase.js';
    import { onAuthStateChanged } from 'firebase/auth';
    import { loadState, saveState, exportData, importData, getTotalXP, getLevel } from '../data/habits.js';

    let currentUser = null;
    const CLOUD_KEY = 'hum-jeetenge-60';

    // ─── Set date in header ─────────────────────────
    const dateEl = document.getElementById('header-date');
    if (dateEl) {
      dateEl.textContent = new Date().toLocaleDateString('en-IN', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
      });
    }

    // ─── Auth State ─────────────────────────────────
    onAuthStateChanged(auth, async (user) => {
      const btnLogin = document.getElementById('btn-login');
      const btnLogout = document.getElementById('btn-logout');
      
      if (user) {
        currentUser = user;
        if (btnLogin) btnLogin.classList.add('hidden');
        if (btnLogout) btnLogout.classList.remove('hidden');
        
        try {
          const docRef = doc(db, 'users', user.uid);
          const docSnap = await getDoc(docRef);
          if (docSnap.exists()) {
            const cloudState = docSnap.data().trackerState;
            if (cloudState) {
              const cloudData = JSON.parse(cloudState);
              const localData = loadState();
              // Merge: use whichever was updated more recently
              const cloudTime = new Date(cloudData.lastSaved || 0).getTime();
              const localTime = new Date(localData.lastSaved || 0).getTime();
              
              if (cloudTime > localTime) {
                saveState(cloudData);
                window.showToast?.(`Welcome back, ${user.displayName}! Cloud data synced.`);
              } else {
                uploadCloudState();
                window.showToast?.(`Welcome, ${user.displayName}! Local data uploaded.`);
              }
            }
          } else {
            uploadCloudState();
          }
        } catch(e) {
          console.error('[HJ] Cloud sync error:', e);
          if (e.code === 'permission-denied') {
            window.showToast?.('Cloud sync: Check Firestore rules!', 'error');
          }
        }
      } else {
        currentUser = null;
        if (btnLogin) btnLogin.classList.remove('hidden');
        if (btnLogout) btnLogout.classList.add('hidden');
      }
    });

    // ─── Cloud Sync ─────────────────────────────────
    let uploadTimeout = null;
    async function uploadCloudState() {
      if (!currentUser) return;
      clearTimeout(uploadTimeout);
      uploadTimeout = setTimeout(async () => {
        try {
          const state = loadState();
          await setDoc(doc(db, 'users', currentUser.uid), {
            trackerState: JSON.stringify(state),
            lastUpdated: new Date().toISOString()
          }, { merge: true });
          console.log('[HJ] Cloud state saved');
        } catch(e) {
          console.error('[HJ] Cloud upload failed:', e);
        }
      }, 2000);
    }

    // ─── Auth Buttons ───────────────────────────────
    document.getElementById('btn-login')?.addEventListener('click', async () => {
      try {
        await signInWithPopup(auth, googleProvider);
      } catch (error) {
        if (error.code !== 'auth/popup-closed-by-user') {
          window.showToast?.(`Login failed: ${error.message}`, 'error');
        }
      }
    });

    document.getElementById('btn-logout')?.addEventListener('click', async () => {
      try {
        await signOut(auth);
        window.showToast?.('Logged out.', 'success');
      } catch(e) {}
    });

    // ─── Export / Import ────────────────────────────
    document.getElementById('btn-export')?.addEventListener('click', () => {
      exportData();
      window.showToast?.('Backup downloaded!');
    });

    document.getElementById('btn-import')?.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      try {
        await importData(file);
        window.showToast?.('Data restored from backup!');
        window.location.reload();
      } catch (err) {
        window.showToast?.('Invalid backup file!', 'error');
      }
    });

    // ─── Header Stats ───────────────────────────────
    function syncHeaderStats() {
      try {
        const state = loadState();
        const xp = getTotalXP(state);
        const level = getLevel(xp);

        const streakEl = document.getElementById('header-streak');
        const xpEl = document.getElementById('header-xp');
        const levelEl = document.getElementById('header-level');

        if (streakEl) streakEl.textContent = state.streak?.current || 0;
        if (xpEl) xpEl.textContent = xp;
        if (levelEl) {
          levelEl.textContent = `Lv.${level.level} ${level.title}`;
          levelEl.style.borderColor = level.color + '40';
          levelEl.style.color = level.color;
        }
      } catch(e) {}
    }

    syncHeaderStats();
    window.addEventListener('hj-state-updated', () => {
      syncHeaderStats();
      uploadCloudState();
    });

    // ─── Toast System ───────────────────────────────
    window.showToast = function(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `px-5 py-3 rounded-xl text-sm font-medium border shadow-2xl flex items-center gap-3 transform transition-all duration-300 translate-y-10 opacity-0`;
      
      if (type === 'success') {
        toast.classList.add('bg-[#111]', 'border-[#2a2a2a]', 'text-white');
        toast.innerHTML = `<span class="text-emerald-400">✓</span> <span>${message}</span>`;
      } else if (type === 'error') {
        toast.classList.add('bg-rose-950/60', 'border-rose-900/40', 'text-rose-200');
        toast.innerHTML = `<span>✕</span> <span>${message}</span>`;
      }

      container.appendChild(toast);
      requestAnimationFrame(() => toast.classList.remove('translate-y-10', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('translate-y-10', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // ─── Confetti ────────────────────────────────────
    window.launchConfetti = function() {
      const container = document.getElementById('confetti-container');
      container.classList.remove('hidden');
      const colors = ['#f5c518', '#ff6b35', '#00d4ff', '#39ff14', '#a78bfa', '#ef4444', '#22d3ee'];
      
      for (let i = 0; i < 80; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.left = Math.random() * 100 + '%';
        piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        piece.style.width = (Math.random() * 8 + 4) + 'px';
        piece.style.height = (Math.random() * 8 + 4) + 'px';
        piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
        piece.style.animationDuration = (Math.random() * 2 + 1.5) + 's';
        piece.style.animationDelay = (Math.random() * 0.5) + 's';
        container.appendChild(piece);
      }
      
      setTimeout(() => {
        container.innerHTML = '';
        container.classList.add('hidden');
      }, 4000);
    }

    // ─── Ambient Particles ──────────────────────────
    (function initParticles() {
      const canvas = document.getElementById('particles-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let particles = [];
      
      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      // Less particles on mobile to ensure 120fps buttery smoothness
      const particleCount = window.innerWidth < 768 ? 15 : 40;
      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          r: Math.random() * 1.5 + 0.5,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          alpha: Math.random() * 0.3 + 0.05,
        });
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x = canvas.width;
          if (p.x > canvas.width) p.x = 0;
          if (p.y < 0) p.y = canvas.height;
          if (p.y > canvas.height) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(245, 197, 24, ${p.alpha})`;
          ctx.fill();
        }
        requestAnimationFrame(draw);
      }
      draw();
    })();
  </script>

</body>
</html>
