---
import Layout from '../layouts/Layout.astro';
import { HABITS, SEGMENTS, TOTAL_DAYS, TOTAL_POINTS, TARGET_POINTS } from '../data/habits.js';
---

<Layout title="Dashboard" activePage="dashboard">

  <!-- Hidden data for JS -->
  <div id="habits-data" class="hidden" data-habits={JSON.stringify(HABITS)} data-segments={JSON.stringify(SEGMENTS)} data-total-days={TOTAL_DAYS} data-total-points={TOTAL_POINTS} data-target={TARGET_POINTS}></div>

  <!-- ═══ HERO SECTION ═══ -->
  <div class="mb-8 animate-fade-in">
    
    <!-- Day Counter + Quote -->
    <div class="hj-card-glow p-6 md:p-8 mb-6 relative overflow-hidden">
      <!-- Shimmer overlay -->
      <div class="absolute inset-0 animate-shimmer pointer-events-none"></div>

      <!-- Anime Character Background -->
      <div class="absolute bottom-0 right-[5%] md:right-[20%] w-[180px] md:w-[280px] opacity-20 md:opacity-40 pointer-events-none z-0 mix-blend-screen transition-transform duration-1000 hover:scale-105">
        <img src="/images/anime_warrior.png" alt="Warrior" class="w-full h-auto drop-shadow-[0_0_15px_rgba(245,197,24,0.5)]" style="-webkit-mask-image: linear-gradient(to top, transparent 5%, black 50%); mask-image: linear-gradient(to top, transparent 5%, black 50%);" />
      </div>
      
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3">
            <div class="px-3 py-1 rounded-full bg-[#f5c518]/10 border border-[#f5c518]/20 text-[#f5c518] text-xs font-bold uppercase tracking-wider">
              🏆 Summer 120 Challenge
            </div>
            <div id="level-badge" class="px-3 py-1 rounded-full bg-[#111] border border-[#222] text-xs font-bold">
              Lv.1
            </div>
          </div>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-2">
            DAY <span id="hero-day" class="text-[#f5c518] font-mono-num">1</span>
            <span class="text-[#333] text-2xl md:text-3xl font-bold"> / 120</span>
          </h1>
          <p id="hero-quote" class="text-sm text-[#666] italic max-w-lg mt-3 leading-relaxed">
            "Discipline is choosing between what you want now and what you want most."
          </p>
        </div>
        
        <!-- Circular Progress Ring -->
        <div class="flex flex-col items-center gap-2">
          <div class="relative w-28 h-28 md:w-32 md:h-32">
            <svg viewBox="0 0 120 120" class="w-full h-full transform -rotate-90">
              <circle cx="60" cy="60" r="52" class="score-ring-bg" />
              <circle id="hero-ring" cx="60" cy="60" r="52" class="score-ring-fill" 
                stroke="#f5c518"
                stroke-dasharray="326.73"
                stroke-dashoffset="326.73" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="hero-pct" class="text-2xl md:text-3xl font-black text-white font-mono-num">0</span>
              <span class="text-[10px] text-[#666] font-semibold uppercase tracking-wider">complete</span>
            </div>
          </div>
          <div class="text-[11px] text-[#555] font-medium"><span id="hero-days-done" class="text-white font-mono-num">0</span> of 120 days</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ STATS + RADAR CHART ROW ═══ -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-8">
    
    <!-- Stats Cards (Left - 2 cols) -->
    <div class="lg:col-span-2 grid grid-cols-2 gap-4 stagger-children">
      <!-- Today's Score -->
      <div class="hj-card p-5 col-span-2">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-[#555] uppercase tracking-wider">Today's Score</span>
          <span id="score-badge" class="score-badge score-gray">---</span>
        </div>
        <div class="flex items-baseline gap-1">
          <span id="today-score" class="text-5xl font-black text-white font-mono-num">0</span>
          <span class="text-xl text-[#333] font-bold font-mono-num">/100</span>
        </div>
        <!-- Mini progress bar -->
        <div class="w-full bg-[#1e1e1e] h-2 rounded-full mt-4 overflow-hidden">
          <div id="score-bar" class="h-full rounded-full transition-all duration-700 ease-out" style="width: 0%; background: linear-gradient(90deg, #f5c518, #ff6b35);"></div>
        </div>
      </div>

      <!-- Streak -->
      <div class="hj-card p-5">
        <span class="text-xs font-bold text-[#555] uppercase tracking-wider">Streak</span>
        <div class="flex items-baseline gap-1 mt-2">
          <span id="stat-streak" class="text-3xl font-black text-white font-mono-num animate-streak-fire">0</span>
          <span class="text-lg">🔥</span>
        </div>
        <div class="text-[11px] text-[#444] mt-1">Best: <span id="stat-best-streak" class="text-white font-mono-num">0</span></div>
      </div>

      <!-- Average -->
      <div class="hj-card p-5">
        <span class="text-xs font-bold text-[#555] uppercase tracking-wider">Avg Score</span>
        <div class="flex items-baseline gap-1 mt-2">
          <span id="stat-avg" class="text-3xl font-black text-white font-mono-num">0</span>
          <span class="text-sm text-[#444] font-bold">/100</span>
        </div>
        <div class="text-[11px] text-[#444] mt-1">XP: <span id="stat-total-xp" class="text-[#f5c518] font-mono-num">0</span></div>
      </div>
    </div>

    <!-- Radar Chart (Right - 3 cols) -->
    <div class="lg:col-span-3 hj-card p-6 flex flex-col items-center justify-center">
      <h3 class="text-sm font-bold text-[#555] uppercase tracking-wider mb-4 self-start">Warrior Stats</h3>
      <div class="radar-container animate-radar-glow">
        <svg id="radar-chart" viewBox="0 0 300 300"></svg>
      </div>
    </div>
  </div>

  <!-- ═══ TODAY'S HABITS CHECKLIST ═══ -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>Today's Mission</span>
        <span id="habits-done-count" class="text-sm font-mono-num text-[#555]">(0/10)</span>
      </h2>
      <div id="day-nav" class="flex items-center gap-2">
        <button id="today-btn" class="hidden hj-btn-ghost px-2 py-1 text-[10px] text-[#f5c518] uppercase tracking-wider">Today</button>
        <button id="prev-day" class="hj-btn-ghost px-2 py-1 text-xs">← Prev</button>
        <span id="viewing-day" class="text-xs font-bold text-[#f5c518] font-mono-num">Day 1</span>
        <button id="next-day" class="hj-btn-ghost px-2 py-1 text-xs">Next →</button>
      </div>
    </div>

    <!-- Habit Groups by Segment -->
    <div id="habits-container" class="flex flex-col gap-6 stagger-children">
      <!-- Built by JS -->
    </div>
  </div>

  <!-- ═══ WEEKLY CHART ═══ -->
  <div class="hj-card p-6 mb-8 animate-fade-in">
    <h3 class="text-sm font-bold text-[#555] uppercase tracking-wider mb-4">Last 7 Days</h3>
    <div class="flex items-end justify-between gap-2 h-32" id="weekly-chart">
      <!-- Built by JS -->
    </div>
    <div class="flex justify-between mt-2 text-[10px] text-[#444] font-medium" id="weekly-labels">
      <!-- Built by JS -->
    </div>
  </div>

  <!-- ═══ SHARE YOUR SCORE ═══ -->
  <div class="hj-card-glow p-6 mb-8 animate-fade-in" style="animation-delay: 0.2s;">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-lg">📣</span>
      <h3 class="text-sm font-bold text-[#555] uppercase tracking-wider">Flex Your Score</h3>
    </div>
    <p class="text-xs text-[#555] mb-5">Share your daily score in the Telegram group or on X and watch others join the grind!</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <button id="share-telegram" class="flex-1 flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-sm transition-all duration-300 border border-[#0088cc]/30 bg-[#0088cc]/10 text-[#0088cc] hover:bg-[#0088cc]/20 hover:border-[#0088cc]/50 hover:shadow-[0_0_20px_rgba(0,136,204,0.15)] active:scale-[0.97]">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        Share to Telegram
      </button>
      <button id="share-x" class="flex-1 flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-sm transition-all duration-300 border border-white/10 bg-white/5 text-white/80 hover:bg-white/10 hover:border-white/20 hover:shadow-[0_0_20px_rgba(255,255,255,0.05)] active:scale-[0.97]">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        Share on X
      </button>
    </div>
    <div id="share-preview" class="mt-4 p-4 rounded-xl bg-[#050505] border border-[#1a1a1a] text-xs text-[#666] font-mono hidden">
      <!-- Preview will be shown here -->
    </div>
  </div>

  <script>
    import {
      HABITS, SEGMENTS, TOTAL_DAYS, TOTAL_POINTS, TARGET_POINTS,
      getCurrentDay, calculateScore, loadState, saveState,
      getDayData, setDayData, getTotalXP, getLevel, getAverageScore,
      getCompletedDays, getSegmentScore, getSegmentMaxScore,
      getDailyQuote, recalcStreak
    } from '../data/habits.js';

    let state = loadState();
    let viewingDay = getCurrentDay();
    const today = getCurrentDay();

    // ─── Render Everything ──────────────────────────
    function render() {
      state = loadState();
      renderHero();
      renderStats();
      renderRadar();
      renderHabits();
      renderWeekly();
    }

    // ─── HERO ───────────────────────────────────────
    function renderHero() {
      document.getElementById('hero-day').textContent = today;
      
      // Quote
      const q = getDailyQuote();
      document.getElementById('hero-quote').innerHTML = `"${q.text}"${q.author ? ` <span class="text-[#444]">— ${q.author}</span>` : ''}`;

      // Progress ring
      const completedDays = getCompletedDays(state);
      const pct = Math.round((completedDays / TOTAL_DAYS) * 100);
      document.getElementById('hero-pct').textContent = pct + '%';
      document.getElementById('hero-days-done').textContent = completedDays;

      const circumference = 2 * Math.PI * 52; // ~326.73
      const offset = circumference - (pct / 100) * circumference;
      const ring = document.getElementById('hero-ring');
      ring.style.strokeDashoffset = offset;

      // Color the ring based on progress
      if (pct >= 70) ring.setAttribute('stroke', '#39ff14');
      else if (pct >= 40) ring.setAttribute('stroke', '#f5c518');
      else ring.setAttribute('stroke', '#ff6b35');

      // Level badge
      const xp = getTotalXP(state);
      const level = getLevel(xp);
      const badge = document.getElementById('level-badge');
      badge.textContent = `Lv.${level.level} ${level.title}`;
      badge.style.borderColor = level.color + '40';
      badge.style.color = level.color;
    }

    // ─── STATS ──────────────────────────────────────
    function renderStats() {
      const dayData = getDayData(state, viewingDay);
      const score = dayData.score;

      // Today's score
      document.getElementById('today-score').textContent = score;
      document.getElementById('score-bar').style.width = score + '%';

      // Score badge
      const badge = document.getElementById('score-badge');
      badge.className = 'score-badge';
      if (score >= TARGET_POINTS) {
        badge.classList.add('score-green');
        badge.textContent = '🟢 On Track';
      } else if (score >= 60) {
        badge.classList.add('score-yellow');
        badge.textContent = '🟡 Almost';
      } else if (score > 0) {
        badge.classList.add('score-red');
        badge.textContent = '🔴 Push Harder';
      } else {
        badge.classList.add('score-gray');
        badge.textContent = 'Not Started';
      }

      // Score bar color
      const bar = document.getElementById('score-bar');
      if (score >= TARGET_POINTS) bar.style.background = 'linear-gradient(90deg, #39ff14, #22d3ee)';
      else if (score >= 60) bar.style.background = 'linear-gradient(90deg, #f5c518, #ff6b35)';
      else bar.style.background = 'linear-gradient(90deg, #ef4444, #ff6b35)';

      // Other stats
      document.getElementById('stat-streak').textContent = state.streak?.current || 0;
      document.getElementById('stat-best-streak').textContent = state.streak?.best || 0;
      document.getElementById('stat-avg').textContent = getAverageScore(state);
      document.getElementById('stat-total-xp').textContent = getTotalXP(state);

      // Update header
      const viewingDayEl = document.getElementById('viewing-day');
      const todayBtn = document.getElementById('today-btn');
      if (viewingDayEl) viewingDayEl.textContent = `Day ${viewingDay}`;
      
      if (todayBtn) {
        if (viewingDay !== today) {
          todayBtn.classList.remove('hidden');
        } else {
          todayBtn.classList.add('hidden');
        }
      }

      // Habits done count
      const doneCount = dayData.habits.filter(Boolean).length;
      document.getElementById('habits-done-count').textContent = `(${doneCount}/10)`;
    }

    // ─── RADAR CHART ────────────────────────────────
    function renderRadar() {
      const svg = document.getElementById('radar-chart');
      const cx = 150, cy = 150, maxR = 110;
      const dayData = getDayData(state, viewingDay);

      // 5 axes: Bear, Compounding, Energy, Consistency, Discipline
      const bearMax = getSegmentMaxScore('bear');
      const compMax = getSegmentMaxScore('compounding');
      const energyMax = getSegmentMaxScore('energy');

      const bearVal = HABITS.reduce((s, h, i) => h.segment === 'bear' && dayData.habits[i] ? s + h.points : s, 0) / bearMax;
      const compVal = HABITS.reduce((s, h, i) => h.segment === 'compounding' && dayData.habits[i] ? s + h.points : s, 0) / compMax;
      const energyVal = HABITS.reduce((s, h, i) => h.segment === 'energy' && dayData.habits[i] ? s + h.points : s, 0) / energyMax;
      
      const completedDays = getCompletedDays(state);
      const trackedDays = Object.keys(state.days).length;
      const consistencyVal = trackedDays > 0 ? completedDays / Math.max(trackedDays, 1) : 0;
      const disciplineVal = getAverageScore(state) / 100;

      const axes = [
        { label: '🐻 Focus', value: bearVal, color: '#ff6b35' },
        { label: '📈 Growth', value: compVal, color: '#00d4ff' },
        { label: '⚡ Energy', value: energyVal, color: '#39ff14' },
        { label: '🎯 Consistency', value: consistencyVal, color: '#a78bfa' },
        { label: '💪 Discipline', value: disciplineVal, color: '#f5c518' },
      ];

      const n = axes.length;
      const angleStep = (2 * Math.PI) / n;

      function polarToXY(angle, radius) {
        return {
          x: cx + radius * Math.cos(angle - Math.PI / 2),
          y: cy + radius * Math.sin(angle - Math.PI / 2),
        };
      }

      let svgContent = '';

      // Background grid (concentric pentagons)
      for (let ring = 1; ring <= 4; ring++) {
        const r = (ring / 4) * maxR;
        let points = '';
        for (let i = 0; i < n; i++) {
          const { x, y } = polarToXY(i * angleStep, r);
          points += `${x},${y} `;
        }
        svgContent += `<polygon points="${points.trim()}" class="radar-grid-line" />`;
      }

      // Axis lines
      for (let i = 0; i < n; i++) {
        const { x, y } = polarToXY(i * angleStep, maxR);
        svgContent += `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" class="radar-axis" />`;
      }

      // Data polygon
      let dataPoints = '';
      const dots = [];
      for (let i = 0; i < n; i++) {
        const val = Math.max(axes[i].value, 0.05); // minimum visible
        const { x, y } = polarToXY(i * angleStep, val * maxR);
        dataPoints += `${x},${y} `;
        dots.push({ x, y, color: axes[i].color });
      }
      svgContent += `<polygon points="${dataPoints.trim()}" class="radar-fill" />`;

      // Data dots
      for (const d of dots) {
        svgContent += `<circle cx="${d.x}" cy="${d.y}" r="5" class="radar-dot" style="fill:${d.color}" />`;
      }

      // Labels
      for (let i = 0; i < n; i++) {
        const { x, y } = polarToXY(i * angleStep, maxR + 22);
        const val = Math.round(axes[i].value * 100);
        svgContent += `<text x="${x}" y="${y}" class="radar-label" dominant-baseline="middle">${axes[i].label}</text>`;
        // Value underneath
        svgContent += `<text x="${x}" y="${y + 14}" class="radar-label" style="fill:${axes[i].color}; font-size:10px; font-family:'JetBrains Mono',monospace;" dominant-baseline="middle">${val}%</text>`;
      }

      svg.innerHTML = svgContent;
    }

    // ─── HABITS CHECKLIST ───────────────────────────
    function renderHabits() {
      const container = document.getElementById('habits-container');
      const dayData = getDayData(state, viewingDay);
      
      let html = '';
      
      for (const seg of SEGMENTS) {
        const segHabits = HABITS.filter(h => h.segment === seg.id);
        const segDone = segHabits.filter((h) => dayData.habits[h.id]).length;
        const segTotal = segHabits.length;
        const segScore = segHabits.reduce((s, h) => dayData.habits[h.id] ? s + h.points : s, 0);
        const segMax = segHabits.reduce((s, h) => s + h.points, 0);

        html += `
          <div class="hj-card p-4 md:p-5">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="text-lg">${seg.emoji}</span>
                <span class="text-sm font-bold" style="color: ${seg.color}">${seg.name}</span>
                <span class="text-[10px] text-[#444] font-medium hidden md:inline">— ${seg.tagline}</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono-num" style="color: ${seg.color}">${segScore}/${segMax}</span>
                <span class="text-[10px] text-[#444]">(${segDone}/${segTotal})</span>
              </div>
            </div>
            <div class="flex flex-col gap-2">
        `;

        for (const habit of segHabits) {
          const checked = dayData.habits[habit.id];
          html += `
            <div class="flex items-center gap-4 p-4 rounded-xl transition-all duration-200 ${checked ? 'bg-[#111] border border-[#222]' : 'bg-[#0d0d0d] hover:bg-[#111] border border-transparent hover:border-[#1e1e1e]'} group cursor-pointer" data-habit-id="${habit.id}" role="button" tabindex="0">
              <div class="habit-check flex-shrink-0 ${checked ? 'checked' : ''}" data-hid="${habit.id}">
                ${checked ? '<svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' : ''}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-base font-bold ${checked ? 'text-[#666] line-through' : 'text-white'} transition-colors">${habit.emoji} ${habit.name}</span>
                </div>
                <span class="text-sm text-[#444] ${checked ? 'line-through' : ''}">${habit.subtitle} — ${habit.descHi}</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold font-mono-num ${checked ? 'text-emerald-400' : 'text-[#333]'} transition-colors">+${habit.points}</span>
              </div>
            </div>
          `;
        }

        html += `
            </div>
          </div>
        `;
      }
      
      container.innerHTML = html;

      // Attach click handlers
      container.querySelectorAll('[data-habit-id]').forEach(el => {
        el.addEventListener('click', (e) => {
          const hid = parseInt(el.dataset.habitId);
          toggleHabit(hid);
        });
      });
    }

    // ─── Toggle Habit ───────────────────────────────
    function toggleHabit(habitId) {
      const dayData = getDayData(state, viewingDay);
      dayData.habits[habitId] = !dayData.habits[habitId];
      setDayData(state, viewingDay, dayData);
      saveState(state);

      // Check for perfect score
      if (dayData.score === 100) {
        window.launchConfetti?.();
        window.showToast?.('💯 PERFECT SCORE! You are UNSTOPPABLE! 🔥', 'success');
      } else if (dayData.score >= TARGET_POINTS && !dayData.habits[habitId]) {
        // Dropped below target (unchecked something)
      } else if (dayData.score >= TARGET_POINTS) {
        window.showToast?.('🟢 Target reached! Keep it up! 🔥', 'success');
      }

      render();
    }

    // ─── WEEKLY CHART ───────────────────────────────
    function renderWeekly() {
      const chart = document.getElementById('weekly-chart');
      const labels = document.getElementById('weekly-labels');
      
      let html = '';
      let labelsHtml = '';
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      
      for (let i = 6; i >= 0; i--) {
        const d = today - i;
        if (d < 1) {
          html += `<div class="flex-1 flex flex-col items-center justify-end"><div class="w-full rounded-lg bg-[#111] h-2"></div></div>`;
          labelsHtml += `<span class="flex-1 text-center">—</span>`;
          continue;
        }
        
        const dayData = getDayData(state, d);
        const score = dayData.score;
        const heightPct = Math.max(score, 3);
        
        let barColor = '#1e1e1e';
        if (score >= TARGET_POINTS) barColor = 'linear-gradient(180deg, #39ff14, #22d3ee)';
        else if (score >= 60) barColor = 'linear-gradient(180deg, #f5c518, #ff6b35)';
        else if (score > 0) barColor = 'linear-gradient(180deg, #ef4444, #ff6b35)';

        const isToday = d === today;
        
        html += `
          <div class="flex-1 flex flex-col items-center justify-end gap-1">
            <span class="text-[10px] font-mono-num ${score >= TARGET_POINTS ? 'text-emerald-400' : score > 0 ? 'text-[#666]' : 'text-[#333]'}">${score > 0 ? score : ''}</span>
            <div class="w-full rounded-lg transition-all duration-500 ${isToday ? 'ring-1 ring-[#f5c518]/30' : ''}" 
              style="height: ${heightPct}%; background: ${barColor}; min-height: 4px;"></div>
          </div>
        `;

        // Calculate date for label
        const startDate = new Date('2026-06-01');
        startDate.setDate(startDate.getDate() + d - 1);
        const dayName = dayNames[startDate.getDay()];
        labelsHtml += `<span class="flex-1 text-center ${isToday ? 'text-[#f5c518] font-bold' : ''}">${dayName}</span>`;
      }

      chart.innerHTML = html;
      labels.innerHTML = labelsHtml;
    }

    // ─── DAY NAVIGATION ─────────────────────────────
    document.getElementById('prev-day')?.addEventListener('click', () => {
      if (viewingDay > 1) { viewingDay--; render(); }
    });
    document.getElementById('next-day')?.addEventListener('click', () => {
      if (viewingDay < today) { viewingDay++; render(); }
    });
    document.getElementById('today-btn')?.addEventListener('click', () => {
      if (viewingDay !== today) { viewingDay = today; render(); }
    });

    // ─── SHARE TO TELEGRAM ────────────────────────────
    function getShareMessage() {
      const dayData = getDayData(state, today);
      const score = dayData.score;
      const xp = getTotalXP(state);
      const level = getLevel(xp);
      const streak = state.streak?.current || 0;
      const doneCount = dayData.habits.filter(Boolean).length;

      let statusEmoji = '🔴';
      let statusText = 'Push Harder';
      if (score >= 80) { statusEmoji = '🟢'; statusText = 'On Track'; }
      else if (score >= 60) { statusEmoji = '🟡'; statusText = 'Almost'; }

      const streakText = streak > 0 ? `🔥 Streak: ${streak} Day${streak > 1 ? 's' : ''}` : '🔥 Streak: Starting today!';

      const msg = [
        `🏆 Hum Jeetenge — Summer 120`,
        ``,
        `📅 Day ${today} / 120`,
        `⚡ Score: ${score}/100 (${statusEmoji} ${statusText})`,
        `✅ Habits: ${doneCount}/10`,
        `${streakText}`,
        `🎮 Level: Lv.${level.level} ${level.title}`,
        ``,
        `Track your own progress 👇`,
        `https://hum-jeetenge-tracker.vercel.app`,
      ].join('\n');

      return msg;
    }

    document.getElementById('share-telegram')?.addEventListener('click', () => {
      const msg = getShareMessage();
      const url = `https://t.me/share/url?url=${encodeURIComponent('https://hum-jeetenge-tracker.vercel.app')}&text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
      window.showToast?.('Opening Telegram... flex that score! 💪', 'success');
    });

    document.getElementById('share-x')?.addEventListener('click', () => {
      const msg = getShareMessage();
      const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
      window.showToast?.('Opening X... let the world know! 🚀', 'success');
    });

    // Show preview on hover
    ['share-telegram', 'share-x'].forEach(id => {
      const btn = document.getElementById(id);
      btn?.addEventListener('mouseenter', () => {
        const preview = document.getElementById('share-preview');
        preview.textContent = getShareMessage();
        preview.classList.remove('hidden');
      });
      btn?.addEventListener('mouseleave', () => {
        document.getElementById('share-preview')?.classList.add('hidden');
      });
    });

    // ─── Initialize ─────────────────────────────────
    render();
    window.addEventListener('hj-state-updated', render);
  </script>

</Layout>
